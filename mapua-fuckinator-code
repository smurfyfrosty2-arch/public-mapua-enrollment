            rawText = rawText.replace(/\b[A-Z]*\d+[A-Z0-9-]*\b/g, ' ');

            const foundDays = new Set();

            const wordMap = [
                [/\b(THURSDAY|THURS|THUR|THU)\b/g, 'TH'],
                [/\b(SUNDAY|SUN)\b/g, 'SU'],
                [/\b(MONDAY|MON)\b/g, 'M'],
