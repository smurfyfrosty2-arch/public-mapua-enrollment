        const beep = new Audio('https://www.soundjay.com/buttons/sounds/button-09.mp3');

        function isUserTypingInPanel() {
            const a = document.activeElement;
            return a === speedInput ||
                   a === refreshInput ||
                   a === nameInput ||
                   a === webhookInput ||
