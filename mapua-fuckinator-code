                            5763719,
                            false
                        );
                        setRedirectExhausted(false);
                        sessionStorage.setItem('mapua_hunter_is_running', wasRunning ? 'true' : 'false');
                        isRecoveryPromptActive = false;
                        window.location.href = MANAGE_SECTION_URL;
                        return;
                    } else {
                        await sendDiscordAlarm(
                            `⚠️ Manage Section Tab Not Available!`,
                            `Checked \`Student/Default.aspx\`, but the **Manage Section** tab is currently not available in your navigation bar (or your session is logged out). Taking no action.`,
                            16776960,
                            true
                        );
                        btn.textContent = `⚠️ Manage Section Unavailable`;
                        setRedirectExhausted(true);
                        setRunningState(false);
                        isRecoveryPromptActive = false;
                        if (!/ManageSection\.aspx/i.test(window.location.pathname)) {
                            window.location.href = HOME_URL;
                        }
