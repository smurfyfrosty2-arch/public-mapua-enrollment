                const msgData2 = await sendDiscordAlarm(
                    `⏳ Final Warning: Session Redirect Pending! — [Attempt 2/2]`,
                    `You didn't respond to the first prompt! Your session is about to be redirected to \`MultipleBrowser.aspx\`.\n\n` +
                    `👉 **React ✅ within ${DISCORD_DECISION_TIMEOUT_SEC}s** to recover your session and return to **Manage Section**.\n` +
