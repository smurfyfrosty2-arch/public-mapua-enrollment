            return cs.display !== 'none' && cs.visibility !== 'hidden';
        };
        const getModal = () => document.querySelector('.swal-overlay--show-modal');

        setInterval(() => {
            const infoModalOpen = !!document.querySelector('.swal-overlay--show-modal .swal-icon--info');
            const userTyping = isUserTypingInPanel();
            if (!isRunning || infoModalOpen || userTyping || isRecoveryPromptActive || isRedirectExhausted) {
                loadingStuckSince = null;
                updateRefreshToggleUI();
                return;
            }
            if (loadingVisible() && !getModal()) {
                if (!loadingStuckSince) loadingStuckSince = Date.now();
                else if (Date.now() - loadingStuckSince > MAX_SPINNER_STUCK_MS) {
                    triggerSafeReload('Loading spinner stuck for >15s');
                    return;
                }
            } else {
                loadingStuckSince = null;
            }
            if (autoRefreshEnabled) {
                remainingRefreshSec--;
                updateRefreshToggleUI();
                if (remainingRefreshSec <= 0) {
                    remainingRefreshSec = refreshIntervalSec;
                    triggerSafeReload(`Scheduled ${refreshIntervalSec}s auto-refresh`);
                }
            }
        }, 1000);

        async function waitForLoading(maxMs = 8000) {
            await sleep(Math.min(150, Math.max(25, scanDelayMs)));
            const start = Date.now();
            while (loadingVisible() && Date.now() - start < maxMs) {
                if (getModal()) return;
                await sleep(40);
            }
        }

        async function waitForModalGone(maxMs) {
            const start = Date.now();
            while (getModal() && Date.now() - start < maxMs) await sleep(30);
            return !getModal();
        }

        function humanClick(el, x, y) {
            const r = el.getBoundingClientRect();
            if (x === undefined) x = r.left + r.width / 2;
            if (y === undefined) y = r.top + r.height / 2;
            const base = { bubbles: true, cancelable: true, composed: true, clientX: x, clientY: y, screenX: x, screenY: y, button: 0, buttons: 1 };
            const fire = (Ctor, type, extra) => {
                if (typeof Ctor !== 'function') return;
                try { el.dispatchEvent(new Ctor(type, Object.assign({}, base, extra))); } catch (e) {}
            };
            fire(window.PointerEvent, 'pointerover', { buttons: 0, pointerType: 'mouse' });
            fire(window.MouseEvent, 'mouseover', { buttons: 0 });
            fire(window.PointerEvent, 'pointerdown', { pointerType: 'mouse', isPrimary: true });
            fire(window.MouseEvent, 'mousedown');
            fire(window.PointerEvent, 'pointerup', { buttons: 0, pointerType: 'mouse', isPrimary: true });
            fire(window.MouseEvent, 'mouseup', { buttons: 0 });
            fire(window.MouseEvent, 'click', { buttons: 0 });
        }

        function clickOutside(overlay) {
            const x = 8, y = 8;
            let target = null;
            try { target = document.elementFromPoint(x, y); } catch (e) {}
            if (!target || !target.classList.contains('swal-overlay')) target = overlay;
            humanClick(target, x, y);
        }

        async function dismissModal() {
            const modal = getModal();
            if (!modal) return 'already-closed';
            const strategies = [
                ['Cancel button humanClick', () => {
                    const c = modal.querySelector('button.swal-button--cancel');
                    if (c) humanClick(c);
                }],
                ['Cancel button .click()', () => {
                    const c = modal.querySelector('button.swal-button--cancel');
                    if (c) c.click();
                }],
                ['click outside', () => clickOutside(modal)],
                ['overlay.click()', () => modal.click()],
                ['OK humanClick', () => {
                    const t = modal.querySelector('.swal-button--confirm') || modal.querySelector('.swal-button--cancel') || modal.querySelector('.swal-button');
                    if (t) humanClick(t);
                }],
                ['OK .click()', () => { const t = modal.querySelector('.swal-button'); if (t) t.click(); }],
                ['swal.close()', () => unsafeWindow.swal.close()],
                ['Escape', () => document.dispatchEvent(new KeyboardEvent('keyup', { key: 'Escape', bubbles: true }))],
                ['remove class', () => modal.classList.remove('swal-overlay--show-modal')],
            ];
            for (const [name, fn] of strategies) {
                try { fn(); } catch (e) {}
                if (await waitForModalGone(600)) return name;
            }
            return null;
        }

        async function confirmYesModal() {
            const modal = getModal();
            if (!modal) return null;
            const yesStrategies = [
                ['Yes humanClick', () => { const b = modal.querySelector('button.swal-button--confirm'); if (b) humanClick(b); }],
                ['Yes .click()', () => { const b = modal.querySelector('button.swal-button--confirm'); if (b) b.click(); }],
                ['jQuery click', () => { if (typeof unsafeWindow.$ === 'function') unsafeWindow.$('.swal-overlay--show-modal button.swal-button--confirm').trigger('click'); }],
                ['swal.close("confirm")', () => { if (unsafeWindow.swal && typeof unsafeWindow.swal.close === 'function') unsafeWindow.swal.close('confirm'); }],
            ];
            for (const [name, fn] of yesStrategies) {
                try { fn(); } catch (e) {}
                const start = Date.now();
                while (Date.now() - start < 900) {
                    const cur = getModal();
                    if (!cur || !cur.querySelector('.swal-icon--info')) return name;
                    await sleep(40);
                }
            }
            return null;
        }

        async function handleModal(subject, sectionName) {
            const pollInterval = Math.min(150, Math.max(30, scanDelayMs));
            const maxPolls = Math.ceil(4500 / pollInterval);
            for (let i = 0; i < maxPolls; i++) {
                const modal = getModal();
                if (modal) {
                    if (modal.querySelector('.swal-icon--info')) {
                        if (!autoConfirmYes) return 'success-manual';
                        const confirmedHow = await confirmYesModal();
                        if (!confirmedHow) return 'success-manual';
                        await waitForLoading(8000);
                        await sleep(Math.min(400, scanDelayMs));
                        const followUp = getModal();
                        if (followUp && !followUp.querySelector('.swal-icon--info')) {
                            await dismissModal();
                            await waitForLoading(4000);
                        }
                        return 'success-auto';
                    }
                    if (!(await dismissModal())) return 'stuck';
                    await waitForLoading(3000);
                    return 'conflict';
                }
                await sleep(pollInterval);
            }
            return 'timeout';
        }

        function toMinutesFromMidnight(hrStr, minStr, ampmStr, fallbackAmPm) {
            let hr = parseInt(hrStr, 10);
            const min = parseInt(minStr || '0', 10);
            const mer = (ampmStr || fallbackAmPm || '').toUpperCase();
            if (mer === 'PM' && hr < 12) hr += 12;
            else if (mer === 'AM' && hr === 12) hr = 0;
            return hr * 60 + min;
        }

        function doesRowMatchTimePreference(trElement) {
            if (timePref === 'any' || !trElement) return true;
            const rowText = trElement.textContent || '';
            const rangeRegex = /(\d{1,2}):(\d{2})\s*([AaPp][Mm])?\s*(?:-|–|to)\s*(\d{1,2}):(\d{2})\s*([AaPp][Mm])?/g;
            const matches = Array.from(rowText.matchAll(rangeRegex));
            if (matches.length === 0) return true;

            const MORNING_START = 7 * 60 + 30, MORNING_END = 12 * 60;
            const EVENING_START = 12 * 60, EVENING_END = 21 * 60;

            for (const m of matches) {
                const [, sh, sm, sMer, eh, em, eMer] = m;
                const startMins = toMinutesFromMidnight(sh, sm, sMer, eMer);
                const endMins = toMinutesFromMidnight(eh, em, eMer, sMer);
                if (timePref === 'morning' && (startMins < MORNING_START || endMins > MORNING_END || endMins <= startMins)) return false;
                if (timePref === 'evening' && (startMins < EVENING_START || endMins > EVENING_END || endMins <= startMins)) return false;
            }
            return true;
        }

        function getTargetCourseRows() {
            const allRows = Array.from(document.querySelectorAll('#current_load_student tr[data-subject]'));
            if (allRows.length === 0) return null;

            checkScheduleLoadChanges();

            const nonExcludedRows = allRows.filter(row => {
                const rawSubj = (row.getAttribute('data-subject') || row.querySelector('td')?.textContent || '').trim();
                return !excludedCourses.includes(normalizeCode(rawSubj));
            });

            if (!onlyMissingSections) return nonExcludedRows;

            return nonExcludedRows.filter(row => {
                const cells = row.querySelectorAll('td');
                const sectionColText = (cells.length >= 3 ? cells[2].textContent : '').replace(/\s+/g, '').toUpperCase();
                const hiddenCell = row.querySelector('td.section_');
                const hiddenSectionFlag = (hiddenCell ? hiddenCell.textContent : '').trim();
                return sectionColText === '' || sectionColText === '-' || sectionColText === 'NONE' || sectionColText === 'N/A' || hiddenSectionFlag === '0';
            });
        }

        function getSectionButtonsForCourse(subject) {
            let candidateButtons = [];
            if (!strictCourseMatch) {
                candidateButtons = Array.from(document.querySelectorAll('.class_course_schedule:not(.hidden) button#add_section'));
            } else {
                const targetCode = normalizeCode(subject);
                const tables = Array.from(document.querySelectorAll('.class_course_schedule:not(.hidden) table.course_table_schedule'));
                const matchingTables = tables.filter(table => {
                    const tableAttrCode = normalizeCode(table.getAttribute('data-section'));
                    const courseSpan = table.querySelector('span.course');
                    const headerCode = normalizeCode(courseSpan ? courseSpan.textContent : '');
                    return (tableAttrCode === targetCode) || (headerCode === targetCode);
                });
                for (const table of matchingTables) {
                    const buttons = Array.from(table.querySelectorAll('button#add_section'));
                    for (const b of buttons) {
                        const btnCode = normalizeCode(b.getAttribute('data-subject'));
                        const parentTr = b.closest('tr');
                        const rowCode = normalizeCode(parentTr ? parentTr.getAttribute('data-course') : '');
                        if (btnCode === targetCode && (!rowCode || rowCode === targetCode)) candidateButtons.push(b);
                    }
                }
            }

            candidateButtons = candidateButtons.filter(b => {
                const actCourse = resolveActualSectionCourse(b, subject);
                return !excludedCourses.includes(normalizeCode(actCourse));
            });

            if (timePref !== 'any') {
                candidateButtons = candidateButtons.filter(b => doesRowMatchTimePreference(b.closest('tr')));
            }

            const scoredButtons = [];
            for (const b of candidateButtons) {
                const actCourse = resolveActualSectionCourse(b, subject);
                const secName = (b.getAttribute('data-section') || '').trim();
                const evalRes = evaluateRowDayPreference(subject, actCourse, secName, b.closest('tr'));
                if (evalRes.allowed) {
                    scoredButtons.push({ btn: b, score: evalRes.score });
                }
            }

            scoredButtons.sort((a, b) => b.score - a.score);
            return scoredButtons.map(item => item.btn);
        }

        async function startHunting() {
            isLoopActive = true;
            try {
                for (let w = 0; w < 10; w++) {
                    if (document.querySelectorAll('#current_load_student tr[data-subject]').length > 0) break;
                    await sleep(500);
                }
                let emptyTableRetries = 0;
                while (isRunning) {
                    if (isRecoveryPromptActive || isRedirectExhausted) { await sleep(500); continue; }
                    await waitWhileUserTyping();
                    let courseRows = getTargetCourseRows();
                    if (courseRows === null) {
                        emptyTableRetries++;
                        btn.textContent = `⏳ Waiting for table... (${emptyTableRetries})`;
                        if (emptyTableRetries > 20) { await triggerSafeReload('Course table failed to load'); return; }
                        await sleep(500);
                        continue;
                    }
                    emptyTableRetries = 0;

                    if (courseRows.length === 0) {
                        await sleep(1500);
                        await waitForLoading(4000);
                        courseRows = getTargetCourseRows();
                        if (courseRows && courseRows.length === 0) {
                            btn.textContent = onlyMissingSections ? '✅ All target courses have sections!' : '❌ All courses excluded or none found!';
                            setBtnColor('#17a2b8');
                            setRunningState(false);
                            updateRefreshToggleUI();
                            return;
                        }
                        continue;
                    }

                    for (let i = 0; i < courseRows.length; i++) {
                        if (!isRunning || isRecoveryPromptActive || isRedirectExhausted) break;
                        await waitWhileUserTyping();
                        let courseRow = courseRows[i];
                        let subject = (courseRow.getAttribute('data-subject') || courseRow.querySelector('td')?.textContent || '').trim();

                        if (excludedCourses.includes(normalizeCode(subject))) continue;

                        if (!courseRow.isConnected) {
                            courseRow = document.querySelector(`#current_load_student tr[data-subject="${subject}"]`);
                            if (!courseRow) continue;
                        }
                        btn.textContent = `⏸️ Scanning ${subject} (${i + 1}/${courseRows.length})`;
                        courseRow.click();
                        await waitForLoading();
                        await sleep(Math.min(300, scanDelayMs));
                        if (!isRunning || isRecoveryPromptActive || isRedirectExhausted) break;

                        if (isSidecarOpen && !isMinimized) populateSidecarCourses();

                        let sectionButtons = getSectionButtonsForCourse(subject);
                        if (sectionButtons.length === 0) { await sleep(scanDelayMs); continue; }

                        let enrolledThisCourse = false;
                        for (let j = 0; j < sectionButtons.length; j++) {
                            if (!isRunning || isRecoveryPromptActive || isRedirectExhausted) break;
                            await waitWhileUserTyping();
                            if (excludedCourses.includes(normalizeCode(subject))) break;

                            let sBtn = sectionButtons[j];
                            let sectionName = (sBtn.getAttribute('data-section') || '').trim();
                            let actualCourse = resolveActualSectionCourse(sBtn, subject);
                            let courseLabel = formatCourseDisplay(actualCourse, subject);

                            if (isSectionIgnored(actualCourse, sectionName)) continue;

                            if (!sBtn.isConnected) {
                                sBtn = getSectionButtonsForCourse(subject).find(b =>
                                    (b.getAttribute('data-section') || '').trim() === sectionName &&
                                    normalizeCode(resolveActualSectionCourse(b, subject)) === normalizeCode(actualCourse)
                                );
                                if (!sBtn) continue;
                            }
                            let parentRow = sBtn.closest('tr');
                            if (parentRow && parentRow.classList.contains('load') && parentRow.classList.contains('hidden')) continue;

                            const liveDayCheck = evaluateRowDayPreference(subject, actualCourse, sectionName, parentRow);
                            if (!liveDayCheck.allowed) continue;

                            const scheduleDetails = parentRow ? (parentRow.textContent || '').replace(/\s+/g, ' ').trim() : '';

                            if (parentRow) parentRow.click();
                            await sleep(Math.min(250, Math.max(20, scanDelayMs)));
                            sBtn.click();
                            await waitForLoading();

                            let result = await handleModal(actualCourse, sectionName);
                            if (result === 'conflict') {
                                recordConflictStrike(actualCourse, sectionName);
                                continue;
                            } else if (result === 'timeout') {
                                continue;
                            } else if (result === 'stuck') {
                                if (autoRefreshEnabled) { await triggerSafeReload('Modal stuck failsafe'); return; }
                                btn.textContent = '⚠️ Modal stuck - see F12';
                                setBtnColor('#ffc107');
                                setRunningState(false);
                                return;
                            } else if (result === 'success-manual') {
                                beep.play().catch(() => {});
                                setBtnColor('#17a2b8');
                                const cleanId = (hunterUserId || '').replace(/[^0-9]/g, '');

                                const webhookMsgData = await sendDiscordAlarm(
                                    `⚠️ Section Found: ${actualCourse}: ${sectionName}`,
                                    `A conflict-free section (**${actualCourse}: ${sectionName}**) ` +
                                    (normalizeCode(actualCourse) !== normalizeCode(subject) ? `*(for **${subject}**)* ` : ``) +
                                    `is waiting on your screen!\n` +
                                    (liveDayCheck.days.length > 0 ? `🗓️ **Days:** \`${liveDayCheck.days.join('/')}\`\n` : ``) +
                                    (scheduleDetails ? `📅 **Details:** \`${scheduleDetails.slice(0, 140)}\`\n\n` : `\n`) +
                                    `👉 **Tap ✅ to ACCEPT or ❌ to IGNORE below within ${DISCORD_DECISION_TIMEOUT_SEC}s!**\n` +
                                    `🔒 *Reaction Locked to:* ${cleanId ? `<@${cleanId}>` : '`⚠️ Set Discord User ID in GUI!`'}`,
                                    16776960,
                                    true
                                );

                                const decision = await waitForDiscordOrManualDecision(actualCourse, sectionName, webhookMsgData);

                                if (decision === 'discord-yes') {
                                    const confirmedHow = await confirmYesModal();
                                    if (confirmedHow) {
                                        await waitForLoading(8000);
                                        await sleep(Math.min(400, scanDelayMs));
                                        const followUp = getModal();
                                        if (followUp && !followUp.querySelector('.swal-icon--info')) {
                                            await dismissModal();
                                            await waitForLoading(4000);
                                        }
                                        enrolledThisCourse = true;
                                        checkScheduleLoadChanges();
                                        await sendDiscordAlarm(
                                            `✅ Remote ✅ Accepted: ${actualCourse}: ${sectionName}!`,
                                            `Successfully enrolled in **${actualCourse}: ${sectionName}** (${courseLabel}) via your Discord reaction!`,
                                            5763719,
                                            true
                                        );
                                        if (isSidecarOpen) populateSidecarCourses();
                                        if (!onlyMissingSections) {
                                            btn.textContent = `✅ Assigned ${actualCourse}: ${sectionName}!`;
                                            setBtnColor('#17a2b8');
                                            setRunningState(false);
                                            updateRefreshToggleUI();
                                            return;
                                        }
                                        btn.textContent = `✅ Got ${actualCourse}: ${sectionName}! Next...`;
                                        setBtnColor('#c8102e');
                                        remainingRefreshSec = refreshIntervalSec;
                                        await sleep(Math.min(800, scanDelayMs));
                                        break;
                                    }
                                } else if (decision === 'discord-no') {
                                    markSectionSkippedImmediately(actualCourse, sectionName, 'discord-skip');
                                    await dismissModal();
                                    await waitForLoading(3000);
                                    await sendDiscordAlarm(
                                        `⏭️ Remote ❌ Ignored: ${actualCourse}: ${sectionName}`,
                                        `Closed the prompt for **${actualCourse}: ${sectionName}**. Added to Ignored list until your schedule changes or you click **🗑️ Clear**!`,
                                        15548997,
                                        false
                                    );
                                    setBtnColor('#c8102e');
                                    remainingRefreshSec = refreshIntervalSec;
                                    continue;
                                } else if (decision === 'answered-on-screen') {
                                    await waitForLoading(4000);
                                    checkScheduleLoadChanges();
                                    if (isSidecarOpen) populateSidecarCourses();
                                    remainingRefreshSec = refreshIntervalSec;
                                    setBtnColor('#c8102e');
                                    break;
                                } else {
                                    btn.textContent = `⚠️ Found ${actualCourse}: ${sectionName}!`;
                                    setBtnColor('#17a2b8');
                                    setRunningState(false);
                                    updateRefreshToggleUI();
                                    return;
                                }
                            } else if (result === 'success-auto') {
                                beep.play().catch(() => {});
                                enrolledThisCourse = true;
                                checkScheduleLoadChanges();
                                sendDiscordAlarm(
                                    `✅ Auto-Enrolled: ${actualCourse}: ${sectionName}!`,
                                    `Locked in section **${actualCourse}: ${sectionName}** (${courseLabel}) automatically!`,
                                    5763719,
                                    true
                                );
                                if (isSidecarOpen) populateSidecarCourses();
                                if (!onlyMissingSections) {
                                    btn.textContent = `✅ Assigned ${actualCourse}: ${sectionName}!`;
                                    setBtnColor('#17a2b8');
                                    setRunningState(false);
                                    updateRefreshToggleUI();
                                    return;
                                }
                                btn.textContent = `✅ Got ${actualCourse}: ${sectionName}! Next...`;
                                remainingRefreshSec = refreshIntervalSec;
                                await sleep(Math.min(800, scanDelayMs));
                                break;
                            }
                        }
                        if (!isRunning || isRecoveryPromptActive || isRedirectExhausted) break;
                        if (!enrolledThisCourse) await sleep(scanDelayMs);
                    }
                }
            } catch (err) {
                console.error('[Hunter] Loop error:', err);
                if (autoRefreshEnabled && isRunning) { await triggerSafeReload('Loop exception recovery'); return; }
                btn.textContent = '💥 Error - see console (F12)';
                setBtnColor('#6f42c1');
                setRunningState(false);
            } finally {
                isLoopActive = false;
            }
        }

        btn.addEventListener('click', (e) => {
            e.preventDefault(); e.stopPropagation();
            if (isRunning) {
                setRunningState(false);
                btn.textContent = '▶️ Resume Hunter';
                setBtnColor('#28a745');
                updateRefreshToggleUI();
            } else {
                if (document.querySelector('.swal-overlay--show-modal .swal-icon--info')) {
                    alert("Please answer the 'Continue? Yes/No' prompt on the screen first!");
                    return;
                }
                setRedirectExhausted(false);
                remainingRefreshSec = refreshIntervalSec;
                setRunningState(true);
                setBtnColor('#c8102e');
                updateRefreshToggleUI();
                if (/MultipleBrowser\.aspx/i.test(window.location.pathname) || isMultipleBrowserHtml(document)) {
                    handleSessionLossOrRedirect('Manual Resume on Multiple Sessions Page');
                    return;
                }
                if (!isLoopActive) startHunting();
            }
        });

        if (isRunning && !isLoopActive && !isRedirectExhausted) startHunting();
    });
})();
