                [/\b(WEDNESDAY|WED)\b/g, 'W'],
                [/\b(FRIDAY|FRI)\b/g, 'F'],
                [/\b(SATURDAY|SAT)\b/g, 'S']
            ];
            for (const [regex, code] of wordMap) {
                if (regex.test(rawText)) {
                    foundDays.add(code);
                    rawText = rawText.replace(regex, ' ');
                }
            }

            const cleanTokens = rawText.replace(/[^A-Z]+/g, ' ').trim().split(/\s+/).filter(Boolean);

            for (const tok of cleanTokens) {
                if (!/^[MTWHFSU]+$/.test(tok)) continue;
                if (/^H+$/.test(tok) || /^U+$/.test(tok)) continue;

                let rem = tok;
                if (rem.includes('TH')) {
                    foundDays.add('TH');
                    rem = rem.replace(/TH/g, '');
                }
                if (rem.includes('SU')) {
                    foundDays.add('SU');
                    rem = rem.replace(/SU/g, '');
                }
                if (rem.includes('H') || rem.includes('U')) continue;

                for (const ch of rem) {
                    if (ch === 'M') foundDays.add('M');
                    else if (ch === 'T') foundDays.add('T');
                    else if (ch === 'W') foundDays.add('W');
                    else if (ch === 'F') foundDays.add('F');
                    else if (ch === 'S') foundDays.add('S');
                }
            }

            return Array.from(foundDays);
