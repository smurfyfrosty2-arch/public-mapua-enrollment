                setRunningState(false);
                await sendDiscordAlarm(
                    `⏸️ Session Recovery Declined (❌)`,
                    `You chose **❌**. Staying paused on the current page without asking again. Click **▶️ Start Hunter** whenever you're ready to resume.`,
                    10197915,
                    false
                );
                btn.textContent = `⏸️ Redirect Paused (Click to Resume)`;
                setBtnColor('#6c757d');
                isRecoveryPromptActive = false;
            } else {
                setRedirectExhausted(true);
                setRunningState(false);
                btn.textContent = `🛑 Redirected (No Response)`;
