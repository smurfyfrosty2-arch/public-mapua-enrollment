            // --- EVALUATE DECISION ---
            if (decision === 'discord-yes') {
                btn.textContent = `🔄 Checking Home Page for Manage Section...`;
                try {
                    const homeRes = await fetch(HOME_URL, { credentials: 'include', cache: 'no-store' });
