        async function pollDiscordYesNoDecision(webhookMsgData, timeoutSec, onTickLabel) {
            const cleanTargetUserId = (hunterUserId || '').replace(/[^0-9]/g, '');
            const workerConfigured = Boolean(CLOUDFLARE_RELAY_URL && CLOUDFLARE_RELAY_URL.startsWith('https://'));
            const hasMsg = webhookMsgData && webhookMsgData.channel_id && webhookMsgData.id;

            if (!workerConfigured || !hasMsg) return 'manual-only';

            const channelId = webhookMsgData.channel_id;
            const alarmMessageId = webhookMsgData.id;
            let lastCheckedMsgId = alarmMessageId;

            const seedResult = await seedYesNoReactionsOnMessage(channelId, alarmMessageId);
            if (!seedResult.checkOk) {
                console.error(`[Discord Remote] Failed to add ✅ via relay. HTTP ${seedResult.status}: ${seedResult.error}`);
            }

            if (cleanTargetUserId.length < 17) {
                console.warn('[Discord Remote] Discord User ID not set (17+ digits); cannot listen for reactions.');
                return 'manual-only';
            }

            const deadline = Date.now() + (timeoutSec * 1000);
            let loopCount = 0;

            while (Date.now() < deadline) {
                const remainingSec = Math.max(1, Math.ceil((deadline - Date.now()) / 1000));
                if (typeof onTickLabel === 'function') {
                    const earlyExit = onTickLabel(remainingSec);
                    if (earlyExit) return earlyExit;
                }

                const yesReactors = await getReactionUsers(channelId, alarmMessageId, '✅');
                if (yesReactors.some(u => u && !u.bot && String(u.id) === cleanTargetUserId)) return 'discord-yes';

                await sleep(250);
                if (typeof onTickLabel === 'function') {
                    const earlyExit = onTickLabel(Math.max(1, Math.ceil((deadline - Date.now()) / 1000)));
                    if (earlyExit) return earlyExit;
                }

                const noReactors = await getReactionUsers(channelId, alarmMessageId, '❌');
                if (noReactors.some(u => u && !u.bot && String(u.id) === cleanTargetUserId)) return 'discord-no';

                if (loopCount++ % 2 === 0) {
                    await sleep(200);
                    const messages = await fetchDiscordMessagesAfter(channelId, lastCheckedMsgId);
                    if (Array.isArray(messages) && messages.length > 0) {
                        messages.sort((a, b) => (BigInt(a.id) > BigInt(b.id) ? 1 : -1));
                        for (const msg of messages) {
                            lastCheckedMsgId = msg.id;
                            const authorId = msg.author ? String(msg.author.id) : '';
                            const content = (msg.content || '').trim().toUpperCase();
                            if (authorId !== cleanTargetUserId) continue;
                            if (content === 'YES' || content === 'Y' || content === '✅') return 'discord-yes';
                            if (content === 'NO' || content === 'N' || content === '❌') return 'discord-no';
                        }
                    }
                }

                await sleep(1100);
            }

            return 'discord-timeout';
        }

