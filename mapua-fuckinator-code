        function hashString(str) {
            let h = 2166136261;
            for (let i = 0; i < str.length; i++) {
                h ^= str.charCodeAt(i);
                h = Math.imul(h, 16777619);
            }
            return 'CL-GIST-' + (h >>> 0).toString(16).toUpperCase();
        }

        function parseAnyChangelog(rawText) {
            const trimmed = (rawText || '').trim();
            if (!trimmed) return null;

            if (trimmed.startsWith('{')) {
                try {
                    const obj = JSON.parse(trimmed);
                    return {
                        versionId: obj.version ? `CL-GIST-${obj.version}` : hashString(trimmed),
                        title: obj.title || `📢 Update ${obj.version || ''}`,
                        body: Array.isArray(obj.changes) ? obj.changes.join('\n') : (obj.changes || trimmed)
                    };
                } catch (e) {}
            }

            const lines = trimmed.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
            const versionHash = hashString(trimmed);
            if (lines.length === 1) {
                return { versionId: versionHash, title: '📢 New Update Installed!', body: lines[0] };
            }
            return { versionId: versionHash, title: `📢 ${lines[0]}`, body: lines.slice(1).join('\n') };
        }

