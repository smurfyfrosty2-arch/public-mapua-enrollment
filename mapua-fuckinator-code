                try { data = raw ? JSON.parse(raw) : null; } catch (e) {}

                if (res.status === 429 && attempt < 4) {
                    const retrySec = (data && typeof data.retry_after === 'number') ? data.retry_after : 0.5;
                    const waitMs = Math.max(150, Math.ceil(retrySec * 1000) + 120);
                    await sleep(waitMs);
                    return callDiscordRelay(payload, attempt + 1);
                }

                const ok = res.status >= 200 && res.status < 300;
                if (!ok && res.status !== 429) {
                    console.warn(`[Relay ${payload.action}] HTTP ${res.status}:`, raw);
                }
                return { status: res.status, ok, data, raw };
            } catch (e) {
                return { status: 0, ok: false, data: null, raw: String(e) };
            }
        }

